@pragmatic-tech-ai:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
# The TODL peers of pragmatic-app-host and pragmatic-realm-adapters are not installed: the edge reaches no TODL engine
# and no Mural (src/tests/no-engine-packages.test.ts). The image build sets the same in its deps stage.
legacy-peer-deps=true
