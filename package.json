{
  "name": "@pragmatic-tech-ai/pragmatic-platform-edge",
  "version": "0.1.1",
  "private": true,
  "description": "The keyless public platform edge: the agent channel, desktop discovery and /healthz, answered by the platform admin console over its internal API.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/pragmatic-tech-ai/pragmatic-platform-edge.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pragmatic-tech-ai/pragmatic-component": "^0.20.0",
    "@pragmatic-tech-ai/pragmatic-hive-protocol": "^0.20.0",
    "@pragmatic-tech-ai/pragmatic-platform-link": "^0.20.0"
  },
  "devDependencies": {
    "@pragmatic-tech-ai/pragmatic-app-host": "^0.20.0",
    "@pragmatic-tech-ai/pragmatic-customer-api-contract": "^0.20.0",
    "@pragmatic-tech-ai/pragmatic-entitlements-contract": "^0.20.0",
    "@pragmatic-tech-ai/pragmatic-release-toolkit": "^0.20.0",
    "@types/node": "^22.20.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  },
  "pragmaticClosureCheck": {
    "Manifest": "closure.json",
    "Dockerfile": "Dockerfile",
    "Apps": [
      "pragmatic-platform-edge"
    ]
  },
  "pragmaticContainerTemplate": {
    "App": "pragmatic-platform-edge",
    "Entry": "src/bin/pragmatic-platform-edged.ts"
  }
}
